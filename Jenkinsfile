pipeline{
  agent any
  stages{
    stage("Build"){
      steps{
        echo"Building"
        sh 'javac hello.java'
      }
    }
    stage("Test"){
      steps{
        echo"Testing"
        sh.'javac hello.java'
      }
    }
    stage("Deploy"){
      stepss{
        echo "Deploying"
        sh.'javac hello.java'
      }
    }
    
